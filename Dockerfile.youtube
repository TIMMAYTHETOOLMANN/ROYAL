# Multi-stage build optimized for YouTube streaming
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src
COPY ["BotCore/BotCore.csproj", "BotCore/"]
WORKDIR "/src/BotCore"
RUN dotnet restore "BotCore.csproj"

COPY ["BotCore/", "."]
RUN dotnet build "BotCore.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "BotCore.csproj" -c Release -o /app/publish \
    --runtime linux-x64 \
    --self-contained true \
    /p:PublishTrimmed=true \
    /p:PublishSingleFile=true

# Install Playwright with Firefox (optimized for YouTube)
RUN dotnet tool install --global Microsoft.Playwright.CLI
ENV PATH="${PATH}:/root/.dotnet/tools"
RUN playwright install firefox
RUN playwright install-deps firefox

# YouTube-optimized runtime with enhanced video processing capabilities
FROM mcr.microsoft.com/dotnet/runtime:8.0 AS runtime
WORKDIR /app

# Enhanced dependencies for YouTube video processing and ad handling
RUN apt-get update && apt-get install -y \
    wget curl ca-certificates fonts-liberation xvfb \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 \
    libcups2 libdbus-1-3 libdrm2 libgbm1 libgtk-3-0 \
    libnspr4 libnss3 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libxshmfence1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=publish /app/publish .
COPY --from=build /root/.cache/ms-playwright /root/.cache/ms-playwright

# YouTube-specific environment configuration
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV PLATFORM=YouTube
ENV DISPLAY=:99
ENV DOTNET_EnableDiagnostics=0

# Performance optimizations for video streaming
ENV DOTNET_gcServer=1
ENV DOTNET_GCHeapCount=4
ENV DOTNET_TieredCompilation=1
ENV DOTNET_TieredPGO=1

# Firefox-specific optimizations for YouTube
ENV MOZ_HEADLESS=1
ENV MOZ_DISABLE_CONTENT_SANDBOX=1

RUN mkdir -p /app/logs /app/data /app/cache

# Health check for monitoring
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 5001 8081

# Optimized startup for YouTube with Xvfb and larger display
ENTRYPOINT ["sh", "-c", "rm -f /tmp/.X99-lock && Xvfb :99 -screen 0 1920x1080x24 -ac +extension GLX +render -noreset & sleep 3 && exec ./BotCore --platform youtube"]
