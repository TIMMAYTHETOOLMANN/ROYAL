{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "BotCore": {
    "Headless": true,
    "LowCpuRam": true,
    "EnableChatEngagement": true
  },
  "Monitoring": {
    "EnablePrometheus": true,
    "EnableHealthChecks": true,
    "EnableMetrics": true
  }
}

